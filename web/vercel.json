{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["icn1"],
  "functions": {"api/index.mjs": {"maxDuration": 60}},
  "crons": [{"path":"/api/sync-notion","schedule":"0 19 * * *"}],
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api?op=:path*"},
    {"source": "/control", "destination": "/control.html"},
    {"source": "/overlay", "destination": "/overlay.html"},
    {"source": "/guide", "destination": "/guide.html"},
    {"source": "/demo", "destination": "/demo.html"}
  ],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "Referrer-Policy", "value": "no-referrer"},
    {"key": "X-Frame-Options", "value": "SAMEORIGIN"}
  ]}]
}
